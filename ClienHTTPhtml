<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<title>Mini Postman</title>

<style>
body { font-family: Arial; padding: 20px; }
.row { display: flex; gap: 10px; margin-bottom: 10px; }
input, select, textarea, button {
  padding: 8px;
}
textarea { width: 100%; height: 120px; }
.container { max-width: 800px; margin: auto; }
.header-row { display: flex; gap: 200px; margin-bottom: 5px; }
.response { margin-top: 20px; }
</style>

</head>
<body>

<div class="container">

  <!-- Ligne principale -->
  <div class="row">
    <select id="method">
      <option>GET</option>
      <option>POST</option>
      <option>PUT</option>
      <option>DELETE</option>
    </select>

    <input type="text" id="url" placeholder="URL" style="flex:1">

    <button onclick="sendRequest()">Envoyer</button>
  </div>

  <!-- Headers -->
  <div id="headersContainer">
    <div class="header-row">
      <input type="text" placeholder="Header key">
      <input type="text" placeholder="Header value">
      <button onclick="addHeader()">+</button>
    </div>
  </div>

  <!-- Body -->
  <h4>Body</h4>
  <textarea id="body" placeholder='{"key":"value"}'></textarea>

  <!-- Response -->
  <div class="response">
    <h4>Status</h4>
    <p id="status"></p>

    <h4>Headers</h4>
    <pre id="resHeaders"></pre>

    <h4>Response body</h4>
    <pre id="response"></pre>
  </div>

</div>

<script>

function addHeader() {
  const container = document.getElementById("headersContainer");

  const div = document.createElement("div");
  div.className = "header-row";

  div.innerHTML = `
    <input type="text" placeholder="Header key">
    <input type="text" placeholder="Header value">
  `;

  container.appendChild(div);
}

async function sendRequest() {

  const method = document.getElementById("method").value;
  const url = document.getElementById("url").value;
  const body = document.getElementById("body").value;

  // récupérer headers
  const headerRows = document.querySelectorAll("#headersContainer .header-row");
  let headers = {};

  headerRows.forEach(row => {
    const key = row.children[0].value;
    const value = row.children[1].value;

    if (key) headers[key] = value;
  });

  let options = {
    method: method,
    headers: headers
  };

  if (method !== "GET" && body) {
    options.body = body;
  }

  try {
    const res = await fetch(url, options);

    // status
    document.getElementById("status").textContent =
      res.status + " " + res.statusText;

    // headers
    let headersText = "";
    res.headers.forEach((value, key) => {
      headersText += key + ": " + value + "\n";
    });
    document.getElementById("resHeaders").textContent = headersText;

    // body
    const text = await res.text();
    document.getElementById("response").textContent = text;

  } catch (err) {
    document.getElementById("response").textContent = err;
  }
}

</script>

</body>
</html>